Content-Disposition: inline; filename=HTMLKND.css
Content-Type: text/css; charset=ascii; name=HTMLKND.css
Content-Location: http://dl.dropbox.com/u/54791301/HTMLKND.css
Content-Transfer-Encoding: 8bit

/* ----------------------------------------------------------- */
/*
*/
html {
background:url(http://dl.dropbox.com/u/54791301/BackGloud.jpg);
}
body {
margin:0;
padding:0;
background: url(http://dl.dropbox.com/u/54791301/HeaderKND.png) no-repeat top center;
font: x-small Verdana, Arial;
text-align: center;
color: #333333;
font-size/* */:/**/small;
font-size: /**/small;
}
.alignleft {
float: left;
margin:5px 5px 5px 0;
}
.alignright {
float:right;
margin:5px 0px 5px 5px;
}
a:link {
text-decoration: none;
color: $mainLinkColor;
}
img {
border:none;
}
a:link,
a:visited {
color: #000000;
text-decoration:none;
}
a:hover {color:#BEBEBE;
text-decoration: none;
}
a {
outline: none;
}
/*-----Menu Imagem-----*/
#menuimagem{
width:900px;
height:157px;
display:block;
position:absolute;
margin:425px 0 0 025px;
}
#home {
background:url(http://dl.dropbox.com/u/54791301/EntrarCinza.png) no-repeat;
width:173px;
height:70px;
float:left;
}
#home:hover {
background:url(http://dl.dropbox.com/u/54791301/Entrar.png) no-repeat;
width:173px;
height:70px;
float:left;
}
#HOME{
width:208px;
height:57px;
display:block;
position:absolute;
margin:-176px 0 0 277px;
}
#contato2 {
background:url(http://dl.dropbox.com/u/54791301/ContatoCinza.png) no-repeat;
width:173px;
height:70px;
float:right;
}
#contato2:hover {
background:url(http://dl.dropbox.com/u/54791301/Contato.png) no-repeat;
width:173px;
height:70px;
float:right;
}
#CONTATO2{
width:208px;
height:57px;
display:block;
position:absolute;
margin:-176px 0 0 455px;
}
/* Header
----------------------------------------------- */
#header-wrapper {
width:1000px;
height:255px;
margin:auto;
}
#header-wrapper h1 {
position: center;
top: 0px;
left: 0px;
color: #000000;
margin: 0px;
padding: 6px;
font: normal 0px/100% "Comic Sans MS", Arial, sans-serif;
}
#header-wrapper h1 a,
#header-wrapper h1 a:visited {
color: #000000;
text-decoration: none;
}
#header-wrapper h1 a:hover {
color: #333333;
text-decoration: none;
}
#header-wrapper p {
position: center;
top: 5px;
left: 13px;
color: #333333;
font: 12px Verdana, Verdana, sans-serif;
visibility:hidden;
}
#logo {
background: url("") no-repeat scroll left top transparent;
clear: both;
height: 273px;
width: 1089px;
margin-top:-260px;
margin-left:-43px;
text-indent: -99999px;
}
#logo a {
height: 250px;
width: 600px;
margin: 0 auto;
display: block;
}
#logo h1, #logo h2 {
text-align: center;
}
/* catnav */
#catnavmenu {
margin-top:-260px;
margin-left:180px;
}
.catnav {
position: relative;
height: 47px;
width:990px;
padding-left: 10px;
margin:0px 0px 0 0px;
overflow: hidden;
}
.catnav li {
float: left;
list-style: none;
}
.catnav li.back {
background: no-repeat right -32px;
width: 9px; height: 38px;
z-index: 8;
position: absolute;
}
.catnav li.back .left {
background: no-repeat top left;
height: 38px;
margin-right: 7px;
}
.catnav li a {
font: bold 12px tahoma, Arial, Helvetica, sans-serif;
text-decoration: none;
color:#FFF;
outline: none;
z-index: 10;
display: block;
float: left;
height: 30px;
position: relative;
overflow: hidden;
padding:5px 11px 0px 0px;
margin:3px 0px 0px 11px;
}
.catnav li a:hover, .catnav li a:active, .catnav li a:visited {
color:#000000;
text-shadow:1px 1px #FFFF;
border: none;
}
/* catnav fim */
/* Busca */
#busca {
background: url("") no-repeat scroll 0 0 transparent;
height: 80px;
width: 990px;
margin-top: 340px;
margin-left: 1px;
}
#txt-busca {
background: none repeat scroll 0 0 transparent;
border: 0 none;
color: #000;
float: left;
font: 12px Arial, Helvetica, sans-serif;
padding: 12px 0 0 270px;
width: 485px;
}
#bt-buscar {
float: left;
margin: 200px 0 0 60x;
margin-left: -45px;
margin-top: 9px;
}
.status-msg-body{
color:#fff;
}
.status-msg-body a:hover{
color:#FF7200;
font-weight: bold;
}
/* Outer-Wrapper
----------------------------------------------- */
#outer-wrapper {
width:1000px;
padding:5px;
margin:0 auto;
text-align:left; }
#main-wrapper {
width: 540px;
float: left;
margin-top: 10px;
margin-left:7px;
padding-left: 24px;
overflow: hidden;
}
#sidebar-wrapper {
width: 210px;
margin-top: 4px;
float: right;
word-wrap: break-word;
}
.leftsidebar-wrapper {
width:210px;
margin-top:4px;
float: left;
word-wrap: break-word;
overflow: hidden;
}
/* Headings
----------------------------------------------- */
h2, h3 {
margin: 0;
}
/* Posts
-----------------------------------------------
*/
/* Conteudo */
#conteudo{
width:530px;
float:left;
margin-left:20px;
display:inline;
overflow:hidden;
}
.topo-post {
background: url("http://dl.dropbox.com/u/54791301/Post.png") no-repeat scroll center center transparent;
height: 145px;
width: 518px;
margin-left:1px;
}
.conteudo-post{
background:url(http://dl.dropbox.com/u/54791301/PostMeio.png) repeat-y;
padding:0px 40px 0px 30px;
margin-left:1px;
text-align:Center;
font:12px Tahoma, Arial, Helvetica, sans-serif;
width: 465px;
}
.conteudo-post a {
color:#BEBEBE;
}
.conteudo-post a:hover {
color:#BEBEBE;
text-decoration:underline;
font-weight:bold;
}
.conteudo-post img {
border:none;
}
.conteudo-post ul li {
background:url('http://img856.imageshack.us/img856/1905/bulleto.gif') no-repeat 0px 4px;
display:block;
text-align:left;
padding:0px 0px 0px 0px;
color:#515151;
text-align:Center;
}
.rodape-post{
width:518px;
height:122px;
margin-left:1px;
background:url(http://dl.dropbox.com/u/54791301/PostFim.png) no-repeat;
}
div.date-meta {
width:170px;
padding:3px 10px 0 30px;
float:left;
overflow:hidden;
display:inline;
}
div.date-meta a{
font:11px Arial, Helvetica, sans-serif;
color: #fff;
}
div.date-meta{
font:11px Tahoma, Arial, Helvetica, sans-serif;
color: #fff;
}
div.date-meta span{
font:bold 11px Tahoma, Arial, Helvetica, sans-serif;
color: #1E90FF;
}
div.date-meta strong{
font:bold 11px Tahoma, Arial, Helvetica, sans-serif;
color: #ffffff;
}
div.date-meta a:hover{
color: #1E90FF;
}
div.entry-meta {
